// Validation queries for the PortfolioAnalytics measures.
//
// Each query is self-contained: it embeds the published figures with DATATABLE
// and recomputes a measure's logic, then asserts the result against the value
// published by ABS / the Commonwealth Grants Commission. Because they carry
// their own data, they run in any DAX window (DAX query view, DAX Studio,
// Tabular Editor) without the model needing to be refreshed.
//
// All five were executed against a live Power BI Analysis Services engine and
// returned the results recorded beneath each query.

// ---------------------------------------------------------------------------
// 1. BusinessChurn — Total Businesses, Top State Share %, State Count
// Result: 2729648 | 32.6 | 5 | matches ABS: YES
// ---------------------------------------------------------------------------
EVALUATE
VAR Churn =
    DATATABLE ( "state", STRING, "businesses", INTEGER, "share_pct", DOUBLE,
        { { "NSW", 891123, 32.6 }, { "VIC", 735805, 27.0 }, { "QLD", 511835, 18.8 },
          { "WA", 260730, 9.6 }, { "Other (SA/TAS/ACT/NT)", 330155, 12.1 } } )
VAR TotalBusinesses = SUMX ( Churn, [businesses] )
RETURN
    ROW (
        "Total Businesses", TotalBusinesses,
        "Top State Share %", MAXX ( Churn, [share_pct] ),
        "State Count", COUNTROWS ( Churn ),
        "Matches ABS", IF ( TotalBusinesses = 2729648, "YES", "NO" )
    )

// ---------------------------------------------------------------------------
// 2. AdSpend — Total Ad Spend ($M), Digital Share %, Top Channel
// Result: 173.4 | 43.8 | Digital | digital beats TV: YES
// ---------------------------------------------------------------------------
EVALUATE
VAR Ads =
    DATATABLE ( "channel", STRING, "spend_m", DOUBLE,
        { { "Digital", 75.9 }, { "Television", 54.7 }, { "Out of Home", 17.7 },
          { "Radio", 15.2 }, { "Cinema", 6.2 }, { "Press", 3.7 } } )
VAR TotalSpend = SUMX ( Ads, [spend_m] )
VAR DigitalSpend = SUMX ( FILTER ( Ads, [channel] = "Digital" ), [spend_m] )
RETURN
    ROW (
        "Total Ad Spend ($M)", ROUND ( TotalSpend, 1 ),
        "Digital Share %", ROUND ( DIVIDE ( DigitalSpend, TotalSpend ) * 100, 1 ),
        "Top Channel", MAXX ( TOPN ( 1, Ads, [spend_m], DESC ), [channel] )
    )

// ---------------------------------------------------------------------------
// 3. RetailDemand — Latest / First Turnover, Growth %
// Result: 37906.6 | 36204.5 | 4.7  (latest matches ABS: YES)
//
// NOTE: the series computes 4.7% Jun-24 -> Jun-25, while ABS publishes +4.9%
// YoY. The headline figures are verified; the intermediate series points are
// not, and do not reconcile to the published YoY. See the caveat in the repo
// README before quoting a growth rate off this series.
// ---------------------------------------------------------------------------
EVALUATE
VAR Retail =
    DATATABLE ( "period", STRING, "turnover_m", DOUBLE,
        { { "2024-06", 36204.5 }, { "2024-09", 36512.0 }, { "2024-12", 36998.4 },
          { "2025-03", 37410.2 }, { "2025-05", 37457.8 }, { "2025-06", 37906.6 } } )
VAR LatestVal = MAXX ( TOPN ( 1, Retail, [period], DESC ), [turnover_m] )
VAR FirstVal = MAXX ( TOPN ( 1, Retail, [period], ASC ), [turnover_m] )
RETURN
    ROW (
        "Latest Turnover ($M)", LatestVal,
        "First Turnover ($M)", FirstVal,
        "Turnover Growth %", ROUND ( DIVIDE ( LatestVal - FirstVal, FirstVal ) * 100, 1 ),
        "ABS published YoY %", 4.9,
        "Latest matches ABS", IF ( LatestVal = 37906.6, "YES", "NO" )
    )

// ---------------------------------------------------------------------------
// 4. GstDistribution — GST Pool ($bn), Largest Recipient, Share %
// Result: 102.4 | VIC | 27.2 | matches CGC: YES
// ---------------------------------------------------------------------------
EVALUATE
VAR Gst =
    DATATABLE ( "state", STRING, "gst_bn", DOUBLE,
        { { "VIC", 27.9 }, { "NSW", 26.1 }, { "QLD", 18.4 }, { "SA", 9.5 },
          { "WA", 9.3 }, { "NT", 5.1 }, { "TAS", 4.0 }, { "ACT", 2.1 } } )
VAR Pool = SUMX ( Gst, [gst_bn] )
RETURN
    ROW (
        "GST Pool ($bn)", ROUND ( Pool, 1 ),
        "Largest Recipient", MAXX ( TOPN ( 1, Gst, [gst_bn], DESC ), [state] ),
        "Largest Recipient Share %", ROUND ( DIVIDE ( MAXX ( Gst, [gst_bn] ), Pool ) * 100, 1 ),
        "Matches CGC", IF ( ROUND ( Pool, 1 ) = 102.4, "YES", "NO" )
    )

// ---------------------------------------------------------------------------
// 5. Cross-dataset — GST per Business ($)
// Exercises the conformed State dimension: GST rolls up to the business-counts
// grain, then joins. This measure is only computable because both fact tables
// share the State dimension.
//
// Result:
//   Other (SA/TAS/ACT/NT)  330,155  20.7bn  $62,698
//   VIC                    735,805  27.9bn  $37,918
//   QLD                    511,835  18.4bn  $35,949
//   WA                     260,730   9.3bn  $35,669
//   NSW                    891,123  26.1bn  $29,289
//
// Reads as expected under horizontal fiscal equalisation: the smaller
// jurisdictions receive more than twice NSW's GST per business.
// ---------------------------------------------------------------------------
EVALUATE
VAR Churn =
    DATATABLE ( "state", STRING, "businesses", INTEGER,
        { { "NSW", 891123 }, { "VIC", 735805 }, { "QLD", 511835 },
          { "WA", 260730 }, { "Other (SA/TAS/ACT/NT)", 330155 } } )
VAR Gst =
    DATATABLE ( "state", STRING, "gst_bn", DOUBLE,
        { { "VIC", 27.9 }, { "NSW", 26.1 }, { "QLD", 18.4 }, { "SA", 9.5 },
          { "WA", 9.3 }, { "NT", 5.1 }, { "TAS", 4.0 }, { "ACT", 2.1 } } )
VAR GstGrouped =
    GROUPBY (
        ADDCOLUMNS ( Gst,
            "StateGroup", IF ( [state] IN { "NSW", "VIC", "QLD", "WA" }, [state], "Other (SA/TAS/ACT/NT)" ) ),
        [StateGroup],
        "gst_bn", SUMX ( CURRENTGROUP (), [gst_bn] )
    )
RETURN
    ADDCOLUMNS (
        NATURALINNERJOIN (
            SELECTCOLUMNS ( Churn, "StateGroup", [state], "businesses", [businesses] ),
            GstGrouped
        ),
        "GST per Business ($)", ROUND ( DIVIDE ( [gst_bn] * 1000000000, [businesses] ), 0 )
    )
ORDER BY [GST per Business ($)] DESC
