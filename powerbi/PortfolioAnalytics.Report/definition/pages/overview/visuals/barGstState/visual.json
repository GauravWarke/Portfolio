{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "barGstState",
  "position": {
    "x": 650,
    "y": 440,
    "z": 0,
    "width": 610,
    "height": 260
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "GstDistribution"
                    }
                  },
                  "Property": "state"
                }
              },
              "queryRef": "GstDistribution.state"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "GstDistribution"
                    }
                  },
                  "Property": "GST Pool ($bn)"
                }
              },
              "queryRef": "GstDistribution.GST Pool ($bn)"
            }
          ]
        }
      }
    },
    "objects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'GST distribution by state ($bn)'"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}