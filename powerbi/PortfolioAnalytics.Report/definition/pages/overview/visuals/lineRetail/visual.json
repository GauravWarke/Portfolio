{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "lineRetail",
  "position": {
    "x": 20,
    "y": 440,
    "z": 0,
    "width": 610,
    "height": 260
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "RetailDemand"
                    }
                  },
                  "Property": "period"
                }
              },
              "queryRef": "RetailDemand.period"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "RetailDemand"
                    }
                  },
                  "Property": "Latest Turnover ($M)"
                }
              },
              "queryRef": "RetailDemand.Latest Turnover ($M)"
            }
          ]
        }
      }
    },
    "objects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Retail turnover trend ($M)'"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}