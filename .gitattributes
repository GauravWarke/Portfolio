# Power Query (M) files. GitHub's Linguist maps the .m extension to Wolfram
# Language by default, which reports a language this repo does not use.
# These are Power BI data-source queries, so classify them as documentation.
*.m linguist-documentation

# Quarto output. This single file is ~2.3 MB because the charts are embedded as
# base64, so left unmarked it accounts for ~95% of the repo and drowns out the
# languages actually written here. It is generated by `quarto render`, not
# hand-authored — the source is analysis/report.qmd.
analysis/report.html linguist-generated

# Chart images are pipeline output, not source.
assets/charts/*.png binary linguist-generated

# Linguist classifies SQL as a "data" language and excludes it from the repo
# language statistics by default. SQL is written and used here (the analytical
# model in sql/, the database layer in supabase/), so opt it back in.
*.sql linguist-detectable=true
